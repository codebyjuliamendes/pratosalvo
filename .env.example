# Copie para .env (não versionado) ou defina no ambiente de deploy.
PORT=3001
DATABASE_PATH=./data/pratosalvo.sqlite
LOG_LEVEL=info                   # debug | info | warn | error | silent
TRUST_PROXY=0                    # 1 atrás de um proxy reverso (Fly, Render, Nginx)
APP_TIMEZONE=America/Sao_Paulo   # fuso de horários enviados sem deslocamento
RATE_LIMIT_PER_MINUTE=60         # escritas por IP por minuto; 0 desativa
REDEEM_RATE_LIMIT_PER_MINUTE=20  # validações de código por IP por minuto; 0 desativa
RESERVATION_HOLD_MINUTES=90      # tolerância da reserva após o início da retirada
MAX_UNITS_PER_CUSTOMER=5         # unidades por cliente em cada oferta (1 a 10)
SEED_DEMO=true                   # ofertas fictícias em banco vazio (padrão: false em produção)
BACKUP_KEEP=14                   # backups mantidos por `npm run backup`

{
  "name": "pratosalvo",
  "version": "2.0.0",
  "private": true,
  "description": "Marketplace de refeições com desconto para reduzir desperdício.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
